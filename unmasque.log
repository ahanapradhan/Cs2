2025-04-30 12:18:00,466- Executable - DEBUG   : ..cur execute..set search_path='unmasque_dscale'; SELECT 
    i_category,
    SUM(ss_net_paid) AS total_sales
FROM 
    store_sales ss
JOIN 
    date_dim d ON ss.ss_sold_date_sk = d.d_date_sk
JOIN 
    item i ON ss.ss_item_sk = i.i_item_sk
WHERE 
    d.d_year = 2001
GROUP BY 
    i_category
ORDER BY 
    total_sales DESC;
 
